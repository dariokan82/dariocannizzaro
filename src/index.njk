---
layout: layouts/base.njk
permalink: /
eleventyExcludeFromCollections: true
---
<div class="hero">
  <img src="{{ ("/assets/img/" + site.hero) | url }}" alt="{{ site.heroAlt }}" width="640" height="340" decoding="async">
  <div class="hero-text">
    <h1 class="wordmark-big">{{ site.title }} <span class="mono">D</span></h1>
    <div class="greeting">
      {%- for line in site.greeting %}
      <p>{{ line }}</p>
      {%- endfor %}
    </div>
    {%- if site.signature %}
    <img class="signature" src="{{ ("/assets/img/" + site.signature) | url }}" alt="" width="240" height="60">
    {%- endif %}
  </div>
</div>

{%- if site.strips.length %}
<div class="strip" style="border-top:1px solid #fff">
  {#- The strip that changes on every visit. The first file is the no-JS state;
      derelict.js picks one at random from data-strips. -#}
  <img src="{{ ("/assets/img/strip/" + site.strips[0]) | url }}" alt="" width="640" height="40"
       data-strips='[{% for s in site.strips %}"{{ ("/assets/img/strip/" + s) | url }}"{% if not loop.last %},{% endif %}{% endfor %}]'>
</div>
{%- endif %}
