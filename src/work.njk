---
layout: layouts/base.njk
permalink: /work/
title: Work
description: Available scripts and produced work by Dario Cannizzaro — features, TV, audio drama, fiction.
---
{%- set slate = work.available | rejectattr("hidden") -%}
<article class="sheet">
  <header class="sheet-head">
    <h1>Work</h1>
    <p class="standfirst">Scripts available to read on request. Everything below the line is finished and out in the world.</p>
  </header>

  <h2 class="shelf-title slug">Available</h2>
  <ul class="shelf">
    {%- for w in slate %}
    <li class="item">
      <h3 class="item-slug">{{ w.title }}{% if w.genre %} <span class="sub">— {{ w.genre }}</span>{% endif %}</h3>
      <p class="item-rail"><span class="chip">{{ w.format }}</span></p>
      {%- if w.logline %}
      <p class="item-logline">{{ w.logline }}</p>
      {%- elif isDev %}
      <p class="item-pending">[logline pending — dev only, never ships]</p>
      {%- endif %}
      {%- if w.note %}
      <p class="item-note">{{ w.note }}</p>
      {%- endif %}
    </li>
    {%- endfor %}
  </ul>
  <p class="shelf-cta"><a href="{{ "/contact/" | url }}">Ask me for any of these →</a></p>

  <h2 class="shelf-title slug">Produced &amp; published</h2>
  <ul class="shelf">
    {%- for w in work.produced %}
    <li class="item">
      <h3 class="item-slug">{{ w.title }}{% if w.genre %} <span class="sub">— {{ w.genre }}</span>{% endif %}</h3>
      <p class="item-rail"><span class="chip">{{ w.format }}</span> <span>{{ w.year }}</span></p>
      <p class="item-credit">{{ w.credit }}</p>
      {%- if w.note %}
      <p class="item-note">{{ w.note }}</p>
      {%- endif %}
      {%- if w.links.length %}
      <p class="item-links">
        {%- for l in w.links %}
        <a href="{{ l.url }}" rel="noopener">{{ l.label }} →</a>
        {%- endfor %}
      </p>
      {%- endif %}
    </li>
    {%- endfor %}
  </ul>
</article>
