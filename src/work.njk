---
layout: layouts/base.njk
permalink: /work/
title: Work
description: Available scripts and produced work by Dario Cannizzaro — features, TV, audio drama, fiction.
---
{%- set slate = work.available | rejectattr("hidden") -%}

<header class="shell page-head">
  <h1>Work</h1>
  <p class="standfirst">Scripts available to read on request. Everything below the second line is finished and out in the world.</p>
</header>

<section class="shell section">
  <div class="section-head">
    <h2 class="section-title">Available</h2>
    <p class="section-aside"><a href="{{ "/contact/" | url }}">Ask for any of these →</a></p>
  </div>

  <ul class="ledger">
    {%- for w in slate %}
    <li class="row reveal">
      <span class="row-index">{% if loop.index < 10 %}0{% endif %}{{ loop.index }}</span>
      <div>
        <h3 class="row-title">{{ w.title }}</h3>
        {%- if w.logline %}
        <p class="row-line">{{ w.logline }}</p>
        {%- elif isDev %}
        <p class="row-line-pending">[logline pending — dev only, never ships]</p>
        {%- endif %}
        {%- if w.note %}
        <p class="row-note">{{ w.note }}</p>
        {%- endif %}
      </div>
      <p class="row-meta">
        <span class="strongline">{{ w.format }}</span>
        {%- if w.genre %}<span>{{ w.genre }}</span>{% endif %}
      </p>
    </li>
    {%- endfor %}
  </ul>
</section>

<section class="shell section">
  <div class="section-head">
    <h2 class="section-title">Produced &amp; published</h2>
  </div>

  <ul class="ledger">
    {%- for w in work.produced %}
    <li class="row reveal">
      <span class="row-index">{% if loop.index < 10 %}0{% endif %}{{ loop.index }}</span>
      <div>
        <h3 class="row-title">{{ w.title }}</h3>
        {%- if w.note %}
        <p class="row-note">{{ w.note }}</p>
        {%- endif %}
        {%- if w.links.length %}
        <p class="row-links">
          {%- for l in w.links %}
          <a href="{{ l.url }}" rel="noopener">{{ l.label }}</a>
          {%- endfor %}
        </p>
        {%- endif %}
      </div>
      <p class="row-meta">
        <span class="strongline">{{ w.year }}</span>
        <span>{{ w.format }}</span>
        <span>{{ w.credit }}</span>
      </p>
    </li>
    {%- endfor %}
  </ul>
</section>
