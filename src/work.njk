---
layout: layouts/base.njk
permalink: /work/
title: The work
description: Scripts available to read, produced screen and audio work, and published books by Dario Cannizzaro.
---
{%- set slate = work.available | rejectattr("hidden") -%}
{#- Three shelves. The first has its own fields (logline, genre); the other two are
    the same object over different data, so they share one loop. -#}
{%- set shelves = [
  { title: "Produced", items: work.produced },
  { title: "Published", items: work.published }
] -%}

<div class="page">
  <p class="eyebrow">The first shelf is available to read on request. The rest is finished and out in the world.</p>

  <h2 class="shelf-title">Available</h2>
  {%- for w in slate %}
  <div class="entry">
    <div>
      <h3 class="entry-title">{{ w.title }}</h3>
      {%- if w.logline %}
      <p class="entry-line">{{ w.logline }}</p>
      {%- elif isDev %}
      <p class="entry-pending">[logline pending — dev only, never ships]</p>
      {%- endif %}
      {%- if w.note %}<p class="entry-note">{{ w.note }}</p>{% endif %}
    </div>
    <p class="entry-meta">
      <span>{{ w.format }}</span>
      {%- if w.genre %}<span>{{ w.genre }}</span>{% endif %}
    </p>
  </div>
  {%- endfor %}
  <div class="shelf-aside">
    <a class="btn" href="{{ "/contact/" | url }}">Ask for any of these</a>
  </div>

  {%- for shelf in shelves %}{% if shelf.items.length %}
  <h2 class="shelf-title">{{ shelf.title }}</h2>
  {%- for w in shelf.items %}
  <div class="entry{% if w.cover %} has-cover{% endif %}">
    {%- if w.cover %}
    <p class="entry-cover">
      {%- if w.links.length %}<a href="{{ w.links[0].url }}" rel="noopener">{% endif %}
      <img src="{{ ("/assets/img/" + w.cover) | url }}" alt="{{ w.coverAlt }}" width="72" loading="lazy" decoding="async">
      {%- if w.links.length %}</a>{% endif %}
    </p>
    {%- endif %}
    <div>
      <h3 class="entry-title">{{ w.title }}</h3>
      {%- if w.logline %}<p class="entry-line">{{ w.logline }}</p>{% endif %}
      {%- if w.note %}<p class="entry-note">{{ w.note }}</p>{% endif %}
      {%- if w.links.length %}
      <p class="links">
        {%- for l in w.links %}
        <a class="btn" href="{{ l.url }}" rel="noopener">{{ l.label }}</a>
        {%- endfor %}
      </p>
      {%- endif %}
    </div>
    <p class="entry-meta">
      <span>{{ w.year }}</span>
      <span>{{ w.format }}</span>
      <span>{{ w.credit }}</span>
    </p>
  </div>
  {%- endfor %}
  {%- endif %}{% endfor %}
</div>
