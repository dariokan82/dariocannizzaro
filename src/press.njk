---
layout: layouts/base.njk
permalink: /press/
title: What others say
description: Interviews, reviews and features on the work of Dario Cannizzaro.
---
<div class="page">
  <p class="eyebrow">Interviews, reviews, and the occasional argument with a stranger in print.</p>

  {%- if press.quotes.length %}
  {%- for q in press.quotes %}
  <figure class="quote">
    <p>“{{ q.text }}”</p>
    <figcaption class="cite">
      {%- if q.url %}<a class="btn" href="{{ q.url }}" rel="noopener">{{ q.outlet }}</a>{% else %}<span>{{ q.outlet }}</span>{% endif %}
      {%- if q.byline %}<span>{{ q.byline }}</span>{% endif %}
      {%- if q.work %}<span>on {{ q.work }}</span>{% endif %}
      {%- if q.date %}<span>{{ q.date }}</span>{% endif %}
    </figcaption>
  </figure>
  {%- endfor %}
  {%- endif %}

  {%- if press.clippings.length %}
  <h2 class="shelf-title">Everything else</h2>
  {%- for c in press.clippings %}
  <div class="entry">
    <div>
      {%- if c.url %}<a class="btn" href="{{ c.url }}" rel="noopener">{{ c.outlet }}</a>{% else %}<span class="btn">{{ c.outlet }}</span>{% endif %}
      {%- if c.title %}<p class="entry-note">{{ c.title }}</p>{% endif %}
    </div>
    <p class="entry-meta">
      {%- if c.kind %}<span>{{ c.kind }}</span>{% endif %}
      {%- if c.work %}<span>{{ c.work }}</span>{% endif %}
      {%- if c.date %}<span>{{ c.date }}</span>{% endif %}
    </p>
  </div>
  {%- endfor %}
  {%- endif %}

  {%- if not press.quotes.length and not press.clippings.length %}
  <p class="aside">Nothing gathered here yet.</p>
  {%- endif %}

  <div class="sub">
    <a class="btn" href="{{ "/about/" | url }}">Back to about</a>
    <a class="btn" href="{{ "/work/" | url }}">The work itself</a>
  </div>
</div>
