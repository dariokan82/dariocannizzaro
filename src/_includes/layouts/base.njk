<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title | upper }} — {{ site.title | upper }}{% else %}{{ site.title | upper }}{% endif %}</title>
<meta name="description" content="{{ description or site.metaDescription }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">

<meta property="og:site_name" content="{{ site.title }}">
<meta property="og:title" content="{% if title %}{{ title }} — {{ site.title }}{% else %}{{ site.title }} — {{ site.role }}{% endif %}">
<meta property="og:description" content="{{ description or site.metaDescription }}">
<meta property="og:type" content="{% if layout == 'layouts/essay.njk' or layout == 'layouts/poem.njk' %}article{% else %}website{% endif %}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}/assets/img/share.jpg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ site.title }} — {{ site.promise }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#000000">

<link rel="icon" href="{{ "/assets/img/favicon.png" | url }}" type="image/png" sizes="96x96">
<link rel="apple-touch-icon" href="{{ "/assets/img/apple-touch-icon.png" | url }}">
<link rel="stylesheet" href="{{ "/assets/css/style.css" | url }}">
</head>
{%- set isHome = page.url == '/' %}
<body>

<a class="skip" href="#main">Skip to content</a>

<div class="box">
  {%- if not isHome %}
  <header class="band head">
    <a class="wordmark" href="{{ "/" | url }}">{{ site.title }} <span class="mono">D</span></a>
    <span class="section-name">{{ navTitle or title }}</span>
  </header>
  {%- endif %}

  <main id="main" class="band">
  {{ content | safe }}
  </main>

  {#- The five doors. `aria-current` lights the circle red for the section you are in;
      Press is About's child, so About stays lit there. Five is odd for a two-column
      grid on purpose: the last cell runs full width and the grid's own rules handle it. -#}
  <nav class="band grid2" aria-label="Primary">
    <a class="btn" href="{{ "/work/" | url }}"{% if page.url == '/work/' %} aria-current="page"{% endif %}>The work</a>
    <a class="btn" href="{{ "/read/" | url }}"{% if '/read/' in page.url %} aria-current="page"{% endif %}>Read something</a>
    <a class="btn" href="{{ "/poems/" | url }}"{% if '/poems/' in page.url %} aria-current="page"{% endif %}>Poems</a>
    <a class="btn" href="{{ "/about/" | url }}"{% if page.url == '/about/' or page.url == '/press/' %} aria-current="page"{% endif %}>About</a>
    <a class="btn" href="{{ "/contact/" | url }}"{% if page.url == '/contact/' %} aria-current="page"{% endif %}>Contacts</a>
  </nav>

  {%- if isHome %}
  <div class="band derelict">
    <span>You are visitor
      {#- No-JS state is six dashes; derelict.js fills the real count from Abacus. -#}
      <span class="odo" data-counter="{{ site.counter.namespace }}/{{ site.counter.key }}" data-start="{{ site.counter.start or 1 }}" aria-live="polite"><span>-</span><span>-</span><span>-</span><span>-</span><span>-</span><span>-</span></span>
    </span>
    <span>Last updated {{ buildDate }}</span>
  </div>
  {%- endif %}
</div>

<p class="copyright">Copyright {{ buildYear }} dariocannizzaro.com</p>

{%- if isHome %}
<script src="{{ "/assets/js/derelict.js" | url }}" defer></script>
{%- endif %}
</body>
</html>
