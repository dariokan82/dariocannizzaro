<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} — {{ site.title }}{% else %}{{ site.title }} — {{ site.role }}{% endif %}</title>
<meta name="description" content="{{ description or site.metaDescription }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">

<meta property="og:site_name" content="{{ site.title }}">
<meta property="og:title" content="{% if title %}{{ title }} — {{ site.title }}{% else %}{{ site.title }} — {{ site.role }}{% endif %}">
<meta property="og:description" content="{{ description or site.metaDescription }}">
<meta property="og:type" content="{% if layout == 'layouts/essay.njk' %}article{% else %}website{% endif %}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}/assets/img/share.jpg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ site.title }} — {{ site.promise }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#0d100e">

<link rel="icon" href="{{ "/assets/img/favicon.png" | url }}" type="image/png" sizes="96x96">
<link rel="apple-touch-icon" href="{{ "/assets/img/apple-touch-icon.png" | url }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Mono:ital,wght@0,300;0,400;0,500;1,400&family=Fraunces:opsz,ital,wght@9..144,0,400..600;9..144,1,400..600&display=swap">
<link rel="stylesheet" href="{{ "/assets/css/style.css" | url }}">
</head>
<body>

<a class="skip" href="#main">Skip to content</a>

<header class="masthead">
  <div class="shell">
    <a class="wordmark" href="{{ "/" | url }}">Dario&nbsp;Cannizzaro</a>
    <nav aria-label="Primary">
      <a href="{{ "/work/" | url }}"{% if page.url == '/work/' %} aria-current="page"{% endif %}>Work</a>
      {%- if collections.writing | length %}
      <a href="{{ "/writing/" | url }}"{% if '/writing/' in page.url %} aria-current="page"{% endif %}>Writing</a>
      {%- endif %}
      {%- if press.quotes.length or press.clippings.length %}
      <a href="{{ "/press/" | url }}"{% if page.url == '/press/' %} aria-current="page"{% endif %}>Press</a>
      {%- endif %}
      <a href="{{ "/about/" | url }}"{% if page.url == '/about/' %} aria-current="page"{% endif %}>About</a>
      <a href="{{ "/contact/" | url }}"{% if page.url == '/contact/' %} aria-current="page"{% endif %}>Contact</a>
    </nav>
  </div>
</header>

<main id="main">
{{ content | safe }}
</main>

<footer class="colophon">
  <div class="shell colophon-grid">
    <ul class="social">
      {%- for s in site.social %}
      <li><a href="{{ s.url }}" rel="me noopener">{{ s.name }}</a></li>
      {%- endfor %}
    </ul>
    <div>
      <p class="fine">{{ site.locationShort }}</p>
      <p class="fine"><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
      <p class="fine">© {{ site.title }}</p>
    </div>
  </div>
</footer>

</body>
</html>
