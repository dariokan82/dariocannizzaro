---
layout: layouts/base.njk
---
<header class="shell page-head">
  <p class="eyebrow"><a href="{{ "/writing/" | url }}">Writing</a> &nbsp;·&nbsp; <time datetime="{{ page.date | isoDate }}">{{ page.date | longDate }}</time></p>
  <h1>{{ title }}</h1>
  {% if standfirst %}<p class="standfirst">{{ standfirst }}</p>{% endif %}
</header>

<article class="shell section">
  <div class="prose">
    {{ content | safe }}
  </div>
  <p class="back"><a href="{{ "/writing/" | url }}">← All writing</a></p>
</article>
