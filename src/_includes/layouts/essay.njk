---
layout: layouts/base.njk
navTitle: Read something
---
<div class="page">
  <p class="eyebrow"><a href="{{ "/read/" | url }}">Read something</a> &nbsp;·&nbsp; <time datetime="{{ page.date | isoDate }}">{{ page.date | longDate }}</time></p>
  <h1 class="page-title">{{ title }}</h1>
  {% if standfirst %}<p class="entry-line" style="margin-bottom:14px">{{ standfirst }}</p>{% endif %}
  <div class="prose">
    {{ content | safe }}
  </div>
  <div class="sub">
    <a class="btn" href="{{ "/read/" | url }}">Back</a>
  </div>
</div>
