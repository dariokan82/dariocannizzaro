---
layout: layouts/base.njk
permalink: /read/
title: Read something
description: Essays, stories and fragments by Dario Cannizzaro, and the books.
---
<div class="page">
  <p class="eyebrow">Essays, fragments, and the odd piece of fiction.</p>

  {%- if collections.writingFeatured | length %}
  <h2 class="shelf-title">Start here</h2>
  {%- for post in collections.writingFeatured %}
  <div class="entry">
    <div>
      <a class="btn" href="{{ post.url | url }}">{{ post.data.title }}</a>
      {% if post.data.standfirst %}<p class="entry-note">{{ post.data.standfirst }}</p>{% endif %}
    </div>
    <p class="entry-meta"><span><time datetime="{{ post.date | isoDate }}">{{ post.date | longDate }}</time></span></p>
  </div>
  {%- endfor %}
  {%- endif %}

  {%- if collections.writing | length %}
  <h2 class="shelf-title">{% if collections.writingFeatured | length %}Everything{% else %}Read now{% endif %}</h2>
  {%- for post in collections.writing %}
  <div class="entry">
    <div>
      <a class="btn" href="{{ post.url | url }}">{{ post.data.title }}</a>
      {% if post.data.standfirst %}<p class="entry-note">{{ post.data.standfirst }}</p>{% endif %}
    </div>
    <p class="entry-meta"><span><time datetime="{{ post.date | isoDate }}">{{ post.date | longDate }}</time></span></p>
  </div>
  {%- endfor %}
  {%- else %}
  <p class="aside">Nothing short here yet. Come back.</p>
  {%- endif %}

  {#- Always present, so the door is never locked: the books. -#}
  <h2 class="shelf-title">Read something longer</h2>
  {%- for w in work.published %}
  <div class="entry{% if w.cover %} has-cover{% endif %}">
    {%- if w.cover %}
    <p class="entry-cover">
      {%- if w.links.length %}<a href="{{ w.links[0].url }}" rel="noopener">{% endif %}
      <img src="{{ ("/assets/img/" + w.cover) | url }}" alt="{{ w.coverAlt }}" width="72" loading="lazy" decoding="async">
      {%- if w.links.length %}</a>{% endif %}
    </p>
    {%- endif %}
    <div>
      <h3 class="entry-title">{{ w.title }}</h3>
      {%- if w.logline %}<p class="entry-line">{{ w.logline }}</p>{% endif %}
      {%- if w.links.length %}
      <p class="links">
        {%- for l in w.links %}
        <a class="btn" href="{{ l.url }}" rel="noopener">{{ l.label }}</a>
        {%- endfor %}
      </p>
      {%- endif %}
    </div>
    <p class="entry-meta">
      <span>{{ w.year }}</span>
      <span>{{ w.format }}</span>
    </p>
  </div>
  {%- endfor %}
</div>
