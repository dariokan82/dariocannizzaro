---
layout: layouts/base.njk
permalink: /read/
title: Read something
description: Short stories and essays by Dario Cannizzaro, free to read, and the books.
---
{#- Three shelves. Stories and essays come from src/writing/ (the `kind` field in each
    file's front matter decides the shelf); the books are always present, so the door is
    never locked. -#}
<div class="page">
  <p class="eyebrow">Stories you can read now, a few essays, and the books.</p>

  {%- set shelves = [
    { title: "Stories", items: collections.stories },
    { title: "Essays", items: collections.essays }
  ] -%}
  {%- for shelf in shelves %}
  {%- if shelf.items | length %}
  <h2 class="shelf-title">{{ shelf.title }}</h2>
  {%- for post in shelf.items %}
  <div class="entry">
    <div>
      <a class="btn" href="{{ post.url | url }}">{{ post.data.title }}</a>
      {% if post.data.standfirst %}<p class="entry-note">{{ post.data.standfirst }}</p>{% endif %}
    </div>
    <p class="entry-meta"><span><time datetime="{{ post.date | isoDate }}">{{ post.date | year }}</time></span></p>
  </div>
  {%- endfor %}
  {%- endif %}
  {%- endfor %}

  {%- if not (collections.stories | length) and not (collections.essays | length) %}
  <p class="aside">Nothing short here yet. Come back.</p>
  {%- endif %}

  {#- Always present, so the door is never locked: the books. -#}
  <h2 class="shelf-title">Read something longer</h2>
  {%- for w in work.published %}
  <div class="entry{% if w.cover %} has-cover{% endif %}">
    {%- if w.cover %}
    <p class="entry-cover">
      {%- if w.links.length %}<a href="{{ w.links[0].url }}" rel="noopener">{% endif %}
      <img src="{{ ("/assets/img/" + w.cover) | url }}" alt="{{ w.coverAlt }}" width="72" loading="lazy" decoding="async">
      {%- if w.links.length %}</a>{% endif %}
    </p>
    {%- endif %}
    <div>
      <h3 class="entry-title">{{ w.title }}</h3>
      {%- if w.logline %}<p class="entry-line">{{ w.logline }}</p>{% endif %}
      {%- if w.links.length %}
      <p class="links">
        {%- for l in w.links %}
        <a class="btn" href="{{ l.url }}" rel="noopener">{{ l.label }}</a>
        {%- endfor %}
      </p>
      {%- endif %}
    </div>
    <p class="entry-meta">
      <span>{{ w.year }}</span>
      <span>{{ w.format }}</span>
    </p>
  </div>
  {%- endfor %}
</div>
